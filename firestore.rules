// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: shares
// Document ID: Firestore auto-ID
// Fields (all required and immutable after creation):
//   - senderName: string, 1–40 characters; a display name only
//   - note: string, 0–280 characters
//   - createdAt: timestamp equal to the server time at creation
//   - track: map with exactly these fields:
//       id (string, 1–60 URL-safe characters), title (string, 1–120),
//       artist (string, 1–120), album (string, 0–140), artwork (http(s) URL
//       or empty, <= 512), previewUrl (http(s) URL, 1–512), appleUrl
//       (http(s) URL or empty, <= 512), durationMs (number, 0–900000),
//       explicit (boolean).
//
// The public music wall is deliberately anonymous because the product has no
// sign-in. It exposes only the submitter's chosen display name and note—never
// an email, UID, or profile document. Reads and validated creates are public;
// edits and deletes are never public.
//
// Legacy collections from the earlier signed-in Resonance app are retained
// below with their existing authenticated-only behavior: users, handles,
// friendships, playlists/{playlistId}/songs, and suggestions.
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =============================================================
    // Helper Functions
    // =============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasExactKeys(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function validString(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }

    function validUrlOrEmpty(value, maximum) {
      return validString(value, 0, maximum) &&
        (value == '' || value.matches('^https?://.*'));
    }

    function validRequiredUrl(value, maximum) {
      return validString(value, 1, maximum) && value.matches('^https?://.*');
    }

    function isValidTrack(track) {
      return track is map &&
        hasExactKeys(track, [
          'id', 'title', 'artist', 'album', 'artwork', 'previewUrl',
          'appleUrl', 'durationMs', 'explicit'
        ]) &&
        validString(track.id, 1, 60) && track.id.matches('^[A-Za-z0-9_-]+$') &&
        validString(track.title, 1, 120) &&
        validString(track.artist, 1, 120) &&
        validString(track.album, 0, 140) &&
        validUrlOrEmpty(track.artwork, 512) &&
        validRequiredUrl(track.previewUrl, 512) &&
        validUrlOrEmpty(track.appleUrl, 512) &&
        track.durationMs is number && track.durationMs >= 0 && track.durationMs <= 900000 &&
        track.explicit is bool;
    }

    // Domain validator. This is called on every permitted write to shares.
    function isValidShare(data) {
      return data is map &&
        hasExactKeys(data, ['senderName', 'note', 'createdAt', 'track']) &&
        validString(data.senderName, 1, 40) &&
        validString(data.note, 0, 280) &&
        data.createdAt is timestamp && data.createdAt == request.time &&
        isValidTrack(data.track);
    }

    // =============================================================
    // Public, write-once music wall
    // =============================================================
    match /shares/{shareId} {
      // The requested no-login experience requires an anonymous readable wall.
      allow read: if true;
      // Anyone may add one strictly shaped, timestamped share. There are no
      // update/delete permissions, so a posted share cannot be altered later.
      allow create: if isValidShare(request.resource.data);
      allow update: if false;
      allow delete: if false;
    }

    // =============================================================
    // Legacy signed-in Resonance data (preserved unchanged in behavior)
    // =============================================================
    function signedIn() { return isAuthenticated(); }
    function isSelf(uid) { return isOwner(uid); }
    function playlistMember(data) { return signedIn() && request.auth.uid in data.memberIds; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasAll(['displayName','displayNameLower','handle','handleLower','avatarDataUrl','musicProvider','createdAt'])
        && request.resource.data.handleLower is string
        && request.resource.data.handleLower.size() >= 3
        && request.resource.data.handleLower.size() <= 20
        && request.resource.data.avatarDataUrl is string
        && request.resource.data.avatarDataUrl.size() < 240000;
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','displayNameLower','avatarDataUrl','musicProvider'])
        && request.resource.data.avatarDataUrl.size() < 240000;
      allow delete: if false;
    }

    match /handles/{handle} {
      allow read: if signedIn();
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/handles/$(handle))
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.requestedBy == resource.data.requestedBy
        && (
          (resource.data.status == 'pending' && request.auth.uid != resource.data.requestedBy && request.resource.data.status == 'accepted')
          || request.resource.data.status == resource.data.status
        );
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    match /playlists/{playlistId} {
      allow read: if playlistMember(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= 50;
      allow update: if playlistMember(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','updatedAt']);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /songs/{songId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/playlists/$(playlistId)).data.memberIds;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/playlists/$(playlistId)).data.memberIds
          && request.resource.data.addedBy == request.auth.uid;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/playlists/$(playlistId)).data.memberIds;
      }
    }

    match /suggestions/{suggestionId} {
      allow read: if signedIn() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'unseen';
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.track == resource.data.track
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['unseen','seen'];
      allow delete: if signedIn() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }
  }
}
