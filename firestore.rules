// ===============================================================
// Resonance Firestore data model
// ===============================================================
//
// profiles/{uid}
//   uid (immutable), displayName, createdAt (immutable), updatedAt
//   This is private account data. Email addresses are never stored here.
//
// playlistCodes/{fourDigitCode}
//   playlistId, playlistName, createdAt (immutable)
//   A direct invitation lookup. Four-digit codes are convenient rather than
//   secret; all reads require an authenticated user and the document cannot be
//   listed.
//
// sharedPlaylists/{playlistId}
//   name, ownerUid (immutable), ownerName (immutable), visibility (immutable:
//   'private' or 'public'), joinCode (immutable), createdAt (immutable),
//   updatedAt
//   ownerName is a public display name only. Public playlists are readable by
//   signed-in users; private playlists are readable by their members.
//
// sharedPlaylists/{playlistId}/members/{uid}
//   userId (immutable), displayName (immutable), playlistName, role
//   (immutable: owner/member), inviteCode (immutable), joinedAt (immutable)
//   The profile display name is copied only after it is checked against the
//   caller's private profile. Public playlist membership names are readable
//   alongside the public playlist; no email or other account data is exposed.
//
// sharedPlaylists/{playlistId}/shares/{shareId}
//   tracks, senderName, note, senderUid, createdAt
//   Members create shares. Public playlists make their shares readable to
//   signed-in visitors; private playlists keep them member-only.
//
// Earlier playlists without ownerName/visibility remain valid private legacy
// playlists, so existing shared lists continue to work. New playlists must use
// the current schema above.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // =============================================================
    // Helpers
    // =============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasExactKeys(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function validString(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }

    function timestampIsNow(value) {
      return value is timestamp && value == request.time;
    }

    function validUrlOrEmpty(value, maximum) {
      return validString(value, 0, maximum) &&
        (value == '' || value.matches('^https?://.*'));
    }

    function validRequiredUrl(value, maximum) {
      return validString(value, 1, maximum) && value.matches('^https?://.*');
    }

    function validJoinCode(code) {
      return code is string && code.matches('^[0-9]{4}$');
    }

    function isCurrentPlaylist(data) {
      return data is map && data.keys().hasAll(['visibility']) &&
        data.visibility in ['private', 'public'];
    }

    function isPublicPlaylist(playlistId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/sharedPlaylists/$(playlistId)) &&
        isCurrentPlaylist(get(/databases/$(database)/documents/sharedPlaylists/$(playlistId)).data) &&
        get(/databases/$(database)/documents/sharedPlaylists/$(playlistId)).data.visibility == 'public';
    }

    function isPlaylistMember(playlistId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/sharedPlaylists/$(playlistId)) &&
        exists(/databases/$(database)/documents/sharedPlaylists/$(playlistId)/members/$(request.auth.uid));
    }

    function isPlaylistOwner(playlistId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/sharedPlaylists/$(playlistId)) &&
        get(/databases/$(database)/documents/sharedPlaylists/$(playlistId)).data.ownerUid == request.auth.uid;
    }

    // Private playlists remain collaborative. Public playlists may only be
    // renamed or deleted by their creator.
    function canManagePlaylist(playlistId) {
      return isPlaylistMember(playlistId) &&
        (!isPublicPlaylist(playlistId) || isPlaylistOwner(playlistId));
    }

    function canViewPlaylist(playlistId) {
      return isPlaylistMember(playlistId) || isPublicPlaylist(playlistId);
    }

    function profileNameMatches(name) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName == name;
    }

    // =============================================================
    // Strict schema validators
    // =============================================================
    function isValidProfile(data) {
      return data is map &&
        hasExactKeys(data, ['uid', 'displayName', 'createdAt', 'updatedAt']) &&
        validString(data.uid, 1, 128) &&
        validString(data.displayName, 1, 40) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    // Current playlist schema used by all newly created playlists.
    function isValidPlaylist(data) {
      return data is map &&
        hasExactKeys(data, [
          'name', 'ownerUid', 'ownerName', 'visibility', 'joinCode',
          'createdAt', 'updatedAt'
        ]) &&
        validString(data.name, 1, 60) &&
        validString(data.ownerUid, 1, 128) &&
        validString(data.ownerName, 1, 40) &&
        data.visibility in ['private', 'public'] &&
        validJoinCode(data.joinCode) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    // Old playlists remain private unless they are deliberately recreated.
    function isValidLegacyPlaylist(data) {
      return data is map &&
        hasExactKeys(data, ['name', 'ownerUid', 'joinCode', 'createdAt', 'updatedAt']) &&
        validString(data.name, 1, 60) &&
        validString(data.ownerUid, 1, 128) &&
        validJoinCode(data.joinCode) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidPlaylistCreate(data) {
      return isValidPlaylist(data) &&
        timestampIsNow(data.createdAt) && timestampIsNow(data.updatedAt);
    }

    function isValidCurrentPlaylistRename(data) {
      return isValidPlaylist(data) && isValidPlaylist(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']) &&
        data.ownerUid == resource.data.ownerUid &&
        data.ownerName == resource.data.ownerName &&
        data.visibility == resource.data.visibility &&
        data.joinCode == resource.data.joinCode &&
        data.createdAt == resource.data.createdAt &&
        timestampIsNow(data.updatedAt);
    }

    function isValidLegacyPlaylistRename(data) {
      return isValidLegacyPlaylist(data) && isValidLegacyPlaylist(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']) &&
        data.ownerUid == resource.data.ownerUid &&
        data.joinCode == resource.data.joinCode &&
        data.createdAt == resource.data.createdAt &&
        timestampIsNow(data.updatedAt);
    }

    function isValidPlaylistRename(data) {
      return isValidCurrentPlaylistRename(data) || isValidLegacyPlaylistRename(data);
    }

    function isValidStoredPlaylist(data) {
      return isValidPlaylist(data) || isValidLegacyPlaylist(data);
    }

    function isValidPlaylistCode(data) {
      return data is map &&
        hasExactKeys(data, ['playlistId', 'playlistName', 'createdAt']) &&
        validString(data.playlistId, 1, 128) &&
        validString(data.playlistName, 1, 60) &&
        data.createdAt is timestamp;
    }

    function isValidPlaylistCodeCreate(data) {
      return isValidPlaylistCode(data) && timestampIsNow(data.createdAt);
    }

    function isValidPlaylistCodeRename(data) {
      return isValidPlaylistCode(data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playlistName']) &&
        data.playlistId == resource.data.playlistId &&
        data.createdAt == resource.data.createdAt;
    }

    function isValidMember(data) {
      return data is map &&
        hasExactKeys(data, ['userId', 'displayName', 'playlistName', 'role', 'inviteCode', 'joinedAt']) &&
        validString(data.userId, 1, 128) &&
        validString(data.displayName, 1, 40) &&
        validString(data.playlistName, 1, 60) &&
        data.role in ['owner', 'member'] &&
        validJoinCode(data.inviteCode) &&
        data.joinedAt is timestamp;
    }

    function isValidMemberCreate(data) {
      return isValidMember(data) && timestampIsNow(data.joinedAt);
    }

    function isValidMemberRename(data) {
      return isValidMember(data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playlistName']) &&
        data.userId == resource.data.userId &&
        data.displayName == resource.data.displayName &&
        data.role == resource.data.role &&
        data.inviteCode == resource.data.inviteCode &&
        data.joinedAt == resource.data.joinedAt;
    }

    function isValidTrack(track) {
      return track is map &&
        hasExactKeys(track, [
          'id', 'title', 'artist', 'album', 'artwork', 'previewUrl',
          'appleUrl', 'durationMs', 'explicit'
        ]) &&
        validString(track.id, 1, 60) && track.id.matches('^[A-Za-z0-9_-]+$') &&
        validString(track.title, 1, 120) &&
        validString(track.artist, 1, 120) &&
        validString(track.album, 0, 140) &&
        validUrlOrEmpty(track.artwork, 512) &&
        validRequiredUrl(track.previewUrl, 512) &&
        validUrlOrEmpty(track.appleUrl, 512) &&
        track.durationMs is number && track.durationMs >= 0 && track.durationMs <= 900000 &&
        track.explicit is bool;
    }

    function isValidTracks(tracks) {
      return tracks is list && tracks.size() >= 1 && tracks.size() <= 12 &&
        isValidTrack(tracks[0]) &&
        (tracks.size() < 2 || isValidTrack(tracks[1])) &&
        (tracks.size() < 3 || isValidTrack(tracks[2])) &&
        (tracks.size() < 4 || isValidTrack(tracks[3])) &&
        (tracks.size() < 5 || isValidTrack(tracks[4])) &&
        (tracks.size() < 6 || isValidTrack(tracks[5])) &&
        (tracks.size() < 7 || isValidTrack(tracks[6])) &&
        (tracks.size() < 8 || isValidTrack(tracks[7])) &&
        (tracks.size() < 9 || isValidTrack(tracks[8])) &&
        (tracks.size() < 10 || isValidTrack(tracks[9])) &&
        (tracks.size() < 11 || isValidTrack(tracks[10])) &&
        (tracks.size() < 12 || isValidTrack(tracks[11]));
    }

    function isValidShare(data) {
      return data is map &&
        hasExactKeys(data, ['tracks', 'senderName', 'note', 'senderUid', 'createdAt']) &&
        isValidTracks(data.tracks) &&
        validString(data.senderName, 1, 40) &&
        validString(data.note, 0, 280) &&
        validString(data.senderUid, 1, 128) &&
        timestampIsNow(data.createdAt);
    }

    // =============================================================
    // Private profile documents
    // =============================================================
    match /profiles/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidProfile(request.resource.data) &&
        request.resource.data.uid == userId &&
        timestampIsNow(request.resource.data.createdAt) &&
        timestampIsNow(request.resource.data.updatedAt);
      allow update: if isOwner(userId) &&
        isValidProfile(request.resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.uid == userId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt']) &&
        timestampIsNow(request.resource.data.updatedAt);
      allow delete: if false;
    }

    // =============================================================
    // Invitation codes
    // =============================================================
    match /playlistCodes/{code} {
      // Direct get only: four digits are a convenience code, not a public list.
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() &&
        validJoinCode(code) &&
        isValidPlaylistCodeCreate(request.resource.data) &&
        existsAfter(/databases/$(database)/documents/sharedPlaylists/$(request.resource.data.playlistId)) &&
        getAfter(/databases/$(database)/documents/sharedPlaylists/$(request.resource.data.playlistId)).data.ownerUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/sharedPlaylists/$(request.resource.data.playlistId)).data.name == request.resource.data.playlistName &&
        getAfter(/databases/$(database)/documents/sharedPlaylists/$(request.resource.data.playlistId)).data.joinCode == code;
      allow update: if isAuthenticated() &&
        validJoinCode(code) &&
        isValidPlaylistCode(resource.data) &&
        isValidPlaylistCodeRename(request.resource.data) &&
        canManagePlaylist(resource.data.playlistId) &&
        existsAfter(/databases/$(database)/documents/sharedPlaylists/$(resource.data.playlistId)) &&
        getAfter(/databases/$(database)/documents/sharedPlaylists/$(resource.data.playlistId)).data.name == request.resource.data.playlistName &&
        getAfter(/databases/$(database)/documents/sharedPlaylists/$(resource.data.playlistId)).data.joinCode == code;
      allow delete: if isAuthenticated() &&
        isValidPlaylistCode(resource.data) &&
        canManagePlaylist(resource.data.playlistId) &&
        !existsAfter(/databases/$(database)/documents/sharedPlaylists/$(resource.data.playlistId));
    }

    // =============================================================
    // Playlists, membership, and shared songs
    // =============================================================
    match /sharedPlaylists/{playlistId} {
      allow get: if isAuthenticated() &&
        (isPlaylistMember(playlistId) ||
          (isCurrentPlaylist(resource.data) && resource.data.visibility == 'public'));
      // Public-list queries must include visibility == 'public'. Private
      // playlists cannot satisfy this rule and therefore cannot leak in a list.
      allow list: if isAuthenticated() &&
        isCurrentPlaylist(resource.data) && resource.data.visibility == 'public';
      allow create: if isAuthenticated() &&
        isValidPlaylistCreate(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid &&
        profileNameMatches(request.resource.data.ownerName) &&
        existsAfter(/databases/$(database)/documents/playlistCodes/$(request.resource.data.joinCode)) &&
        existsAfter(/databases/$(database)/documents/sharedPlaylists/$(playlistId)/members/$(request.auth.uid));
      allow update: if canManagePlaylist(playlistId) &&
        isValidPlaylistRename(request.resource.data) &&
        existsAfter(/databases/$(database)/documents/playlistCodes/$(resource.data.joinCode)) &&
        getAfter(/databases/$(database)/documents/playlistCodes/$(resource.data.joinCode)).data.playlistId == playlistId &&
        getAfter(/databases/$(database)/documents/playlistCodes/$(resource.data.joinCode)).data.playlistName == request.resource.data.name;
      allow delete: if canManagePlaylist(playlistId) &&
        isValidStoredPlaylist(resource.data) &&
        !existsAfter(/databases/$(database)/documents/playlistCodes/$(resource.data.joinCode));

      match /members/{memberUid} {
        // Public rosters contain only chosen display names. Private rosters are
        // visible only to their members; users can always read their own row.
        allow get: if isAuthenticated() &&
          (memberUid == request.auth.uid || canViewPlaylist(playlistId));
        allow list: if canViewPlaylist(playlistId);
        allow create: if isAuthenticated() &&
          memberUid == request.auth.uid &&
          isValidMemberCreate(request.resource.data) &&
          request.resource.data.userId == request.auth.uid &&
          profileNameMatches(request.resource.data.displayName) &&
          (
            (
              request.resource.data.role == 'owner' &&
              existsAfter(/databases/$(database)/documents/sharedPlaylists/$(playlistId)) &&
              getAfter(/databases/$(database)/documents/sharedPlaylists/$(playlistId)).data.ownerUid == request.auth.uid &&
              getAfter(/databases/$(database)/documents/sharedPlaylists/$(playlistId)).data.name == request.resource.data.playlistName &&
              getAfter(/databases/$(database)/documents/sharedPlaylists/$(playlistId)).data.joinCode == request.resource.data.inviteCode
            ) ||
            (
              request.resource.data.role == 'member' &&
              exists(/databases/$(database)/documents/sharedPlaylists/$(playlistId)) &&
              get(/databases/$(database)/documents/sharedPlaylists/$(playlistId)).data.name == request.resource.data.playlistName &&
              get(/databases/$(database)/documents/sharedPlaylists/$(playlistId)).data.joinCode == request.resource.data.inviteCode &&
              (
                isPublicPlaylist(playlistId) ||
                (
                  exists(/databases/$(database)/documents/playlistCodes/$(request.resource.data.inviteCode)) &&
                  get(/databases/$(database)/documents/playlistCodes/$(request.resource.data.inviteCode)).data.playlistId == playlistId &&
                  get(/databases/$(database)/documents/playlistCodes/$(request.resource.data.inviteCode)).data.playlistName == request.resource.data.playlistName
                )
              )
            )
          );
        // Rename propagation is bundled with a playlist rename. For public
        // playlists only the creator may do that; private playlists retain
        // their existing collaborative edit behavior.
        allow update: if canManagePlaylist(playlistId) &&
          isValidMemberRename(request.resource.data) &&
          existsAfter(/databases/$(database)/documents/sharedPlaylists/$(playlistId)) &&
          getAfter(/databases/$(database)/documents/sharedPlaylists/$(playlistId)).data.name == request.resource.data.playlistName;
        // Membership documents are removed only in the same batch as deleting
        // the parent playlist.
        allow delete: if canManagePlaylist(playlistId) &&
          !existsAfter(/databases/$(database)/documents/sharedPlaylists/$(playlistId));
      }

      match /shares/{shareId} {
        allow read: if canViewPlaylist(playlistId);
        allow create: if isPlaylistMember(playlistId) &&
          isValidShare(request.resource.data) &&
          request.resource.data.senderUid == request.auth.uid &&
          profileNameMatches(request.resource.data.senderName);
        allow update: if false;
        allow delete: if isPlaylistMember(playlistId) &&
          (resource.data.senderUid == request.auth.uid ||
            isPlaylistOwner(playlistId) ||
            !existsAfter(/databases/$(database)/documents/sharedPlaylists/$(playlistId)));
      }
    }

    // The home-page collection-group query is restricted to the caller's own
    // memberships. It cannot reveal private memberships belonging to others.
    match /{path=**}/members/{memberUid} {
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
